# Copy to .env (never commit .env). All keys stay server-side.

# Which AI provider reads the bill and writes explanations: gemini (default) or anthropic
LLM_PROVIDER=gemini

# --- Google Gemini (free keys: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model id as listed in Google AI Studio. Google's pricing page lists gemini-3.8-flash with a free tier.
# If you get a "model not found" error, pick another id from AI Studio.
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic (optional alternative) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Upload limit in MB (server rejects larger files)
MAX_UPLOAD_MB=8
# Seconds to wait for the model before giving up
ANTHROPIC_TIMEOUT_S=60
# Set to 1 to skip the AI call and return a clearly-labelled SYNTHETIC bill (offline demos/UI work only)
BILLSHOCKER_SYNTHETIC=0
# Flask
FLASK_DEBUG=0
PORT=5000
